### Global ignores ###

# IntelliJ
.idea/
*.iml

# VSCode (si jamais)
.vscode/

# OS junk
.DS_Store
Thumbs.db

# Node (frontend)
node_modules/
dist/
.vite/
coverage/
test-results/
playwright-report/

# Logs
*.log

# Temporary files
*.tmp
*.swp

# Metals (root-level, opened as a multi-root workspace)
.metals/

# Local SQLite dev database
*.db

# Frontend static build, staged into backend resources by build-release.ps1 before packaging -
# regenerated every build, never hand-edited.
deepstone-backend/src/main/resources/static/

# Debug rooms for the hub's "Debug Rooms" dev tool (frontend/scripts/convert-tiled-room.mjs
# --out=... points here) - scratch files for previewing a room while authoring it, never real,
# shippable content.
deepstone-backend/debug-rooms/

# Third-party art and audio: none of it is stored in this repo. It lives in the private
# deepstone-licensed-assets repo and is copied here by sync-assets.ps1 (see CREDITS.md and
# README.md). The atlas files in frontend/public/atlas stay tracked, they only hold coordinates.
frontend/public/sprites/
frontend/public/audio/
