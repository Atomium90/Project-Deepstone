### Global ignores ###

# IntelliJ
.idea/
*.iml

# VSCode (si jamais)
.vscode/

# OS junk
.DS_Store
Thumbs.db

# Node (frontend)
node_modules/
dist/
.vite/

# Logs
*.log

# Temporary files
*.tmp
*.swp

# Metals (root-level, opened as a multi-root workspace)
.metals/

# Local SQLite dev database
*.db

# Frontend static build, staged into backend resources by build-release.ps1 before packaging -
# regenerated every build, never hand-edited.
deepstone-backend/src/main/resources/static/

